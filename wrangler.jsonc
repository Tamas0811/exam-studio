{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exam-studio",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "GEMINI_MODEL": "gemini-flash-latest" }
}
